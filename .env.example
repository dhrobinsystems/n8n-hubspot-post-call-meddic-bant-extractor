# -----------------------------------------------------------------------------
# n8n-hubspot-post-call-meddic-bant-extractor
# Copy to .env (git-ignored) for the Node.js mirror, or set the same variables
# on the n8n host. Every value below is a dummy placeholder.
# -----------------------------------------------------------------------------

# --- Safety switches (fail-safe: anything other than an explicit false keeps them on)
DRY_RUN=true
SANDBOX_MODE=true

# --- Node.js server
PORT=3000
WEBHOOK_PATH=/webhooks/post-call
LOG_LEVEL=info

# --- Webhook signature verification (HMAC-SHA256)
WEBHOOK_SIGNING_SECRET=your_webhook_signing_secret_here
WEBHOOK_SIGNATURE_HEADER=x-signature
WEBHOOK_TIMESTAMP_HEADER=x-signature-timestamp
WEBHOOK_REQUIRE_SIGNATURE=true
WEBHOOK_REQUIRE_TIMESTAMP=false
WEBHOOK_TOLERANCE_SECONDS=300
WEBHOOK_MAX_BODY_BYTES=2000000

# --- Participant classification (comma-separated seller-side email domains)
INTERNAL_EMAIL_DOMAINS=example.com

# --- LLM extraction
# mock = offline keyword heuristics (no transcript leaves the machine, dry run only)
# openai | anthropic = structured JSON output; LLM_MODEL must be a model ID that
# supports JSON-schema structured output (OpenAI) or tool use (Anthropic).
LLM_PROVIDER=mock
LLM_MODEL=
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_BASE_URL=https://api.openai.com/v1
ANTHROPIC_API_KEY=your_anthropic_api_key_here
ANTHROPIC_BASE_URL=https://api.anthropic.com
LLM_TIMEOUT_MS=60000
LLM_MAX_ATTEMPTS=2

# --- Privacy guards applied before any LLM call
PII_REDACTION=true
MAX_TRANSCRIPT_CHARS=60000

# --- HubSpot (Private App token). A placeholder token keeps the client offline.
HUBSPOT_PRIVATE_APP_TOKEN=your_hubspot_private_app_token_here
HUBSPOT_PORTAL_ID=your_hubspot_portal_id_here
HUBSPOT_SANDBOX_PORTAL_ID=your_hubspot_sandbox_portal_id_here
HUBSPOT_BASE_URL=https://api.hubapi.com
HUBSPOT_APP_BASE_URL=https://app.hubspot.com
# Stage used for the synthetic deal while the HubSpot token is a placeholder
SIMULATE_DEAL_STAGE_ID=qualifiedtobuy

# --- Slack (incoming webhook OR bot token + channel). Sandbox targets are required while SANDBOX_MODE=true.
SLACK_WEBHOOK_URL=your_slack_incoming_webhook_url_here
SLACK_BOT_TOKEN=your_slack_bot_token_here
SLACK_CHANNEL_ID=your_slack_channel_id_here
SLACK_SANDBOX_WEBHOOK_URL=your_slack_sandbox_incoming_webhook_url_here
SLACK_SANDBOX_CHANNEL_ID=your_slack_sandbox_channel_id_here
# Optional JSON map of HubSpot owner ID -> Slack user ID for @mentions on blocked gates
OWNER_SLACK_MAP_JSON={}

# --- Qualification rules (stage gates). Defaults to config/qualification-rules.local.json, then the example file.
QUALIFICATION_RULES_PATH=
# n8n: paste the rules as single-line JSON here to override the rules embedded in the workflow
QUALIFICATION_RULES_JSON=
